# --- Local configuration & secrets ---
.env
.env.*
!.env.example
# 로컬 설정 파일 (공유용 템플릿은 conf.example.json)
conf.json
conf.json.tmp
# 예전 TOML 설정을 옮기고 남은 백업
conf.toml
conf.toml.bak

# --- Build & packaging output ---
dist/
# 사용 설명서 HTML (docs/render_user_manual.py 가 생성)
docs/user_manual_html/
build/
*.egg-info/
*.spec
MultiAgentOrchestrator_bundle*
MultiAgentOrchestrator_offline*
vendor/
wheelhouse/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Runtime data ---
*.db
*.sqlite
*.sqlite3
*.log
workspace/
# MCP 서버 설치본 (npm install / git clone 으로 로컬에 생성)
mcp_node/
mcp_sandbox/

# --- Editors & OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
